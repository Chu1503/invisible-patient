{
  "name": "invisible-patient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run security:scan && npm run security:audit && npm run lint && npm run build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "mobile:web": "node --env-file-if-exists=.env.local scripts/build-mobile-web.mjs",
    "mobile:sync": "npm run mobile:web && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:apk": "node --env-file-if-exists=.env.local scripts/build-android-apk.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
