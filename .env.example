# Server only. Never prefix this variable with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=replace_with_your_anthropic_key

# Optional server-side controls.
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_MAX_OUTPUT_TOKENS=220
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_MAX_RETRIES=1

# Per client limits. The window defaults to 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=5
CLAUDE_RATE_LIMIT_MAX=12
CLAUDE_TOKEN_BUDGET=30000

# Native app build. Set this to the deployed HTTPS website origin, without /api.
# It is compiled into the Android app and is not a secret.
MOBILE_API_BASE_URL=https://invizy.app

# Origins allowed to call the API from installed Capacitor builds.
MOBILE_APP_ORIGINS=https://localhost

# Public Supabase project values. These identify the project but do not grant
# administrative access. Never expose a service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
